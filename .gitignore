# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# firebase deploy cache
/.firebase/

# firebase emulator logs
*-debug.log

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev/screenshot scripts (session-specific paths). The two the build and the docs
# check depend on are tracked; listing the directory's contents rather than the directory
# itself is what lets these negations apply.
/scripts/*
!/scripts/gen-api-mirror.mjs
!/scripts/verify-docs.mjs

# generated from src/content/api.json by scripts/gen-api-mirror.mjs on every prebuild
/public/llms.txt
/public/docs/
