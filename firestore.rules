rules_version = '2';

// All license data is written exclusively by the activate function via the Admin
// SDK, which bypasses these rules. No client (web or Unity) reads or writes
// Firestore directly, so everything is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
